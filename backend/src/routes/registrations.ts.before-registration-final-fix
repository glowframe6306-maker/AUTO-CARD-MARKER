import { Router } from "express";
import prisma from "../prisma";
import { hashPassword } from "../utils/auth";

const router = Router();

router.post("/", async (req, res) => {
  try {
    const { name, rcStudentId, email, dob, password } = req.body ?? {};

    console.log("REGISTRATION REQUEST:", {
      name: !!name,
      rcStudentId: !!rcStudentId,
      email: !!email,
      dob: !!dob,
      password: !!password,
      contentType: req.headers["content-type"],
    });

    if (!name || !rcStudentId || !email || !dob || !password) {
      return res.status(400).json({
        error: "Missing required registration fields.",
        received: {
          name: !!name,
          rcStudentId: !!rcStudentId,
          email: !!email,
          dob: !!dob,
          password: !!password,
        },
      });
    }

    const parsedDob = new Date(normalizedDob);

    if (!normalizedName || !normalizedRcStudentId || !normalizedEmail) {
      return res.status(400).json({
        error: "All registration fields are required.",
      });
    }

    if (Number.isNaN(parsedDob.getTime())) {
      return res.status(400).json({
        error: "Invalid date of birth.",
      });
    }

    const existingUserByAccount = await prisma.user.findUnique({
      where: { accountId: normalizedRcStudentId },
      select: { id: true },
    });

    if (existingUserByAccount) {
      return res.status(409).json({
        error: "RC Student ID already exists.",
      });
    }

    const existingUserByEmail = await prisma.user.findUnique({
      where: { email: normalizedEmail },
      select: { id: true },
    });

    if (existingUserByEmail) {
      return res.status(409).json({
        error: "Email already in use.",
      });
    }

    const existingMember = await prisma.memberProfile.findUnique({
      where: { memberId: normalizedRcStudentId },
      select: { id: true },
    });

    if (existingMember) {
      return res.status(409).json({
        error: "RC Student ID already exists.",
      });
    }

    const existingPending = await prisma.pendingRegistration.findUnique({
      where: { rcStudentId: normalizedRcStudentId },
      select: { id: true, status: true },
    });

    if (existingPending) {
      return res.status(409).json({
        error: "A registration for this RC Student ID is already pending.",
      });
    }

    const passwordHash = await hashPassword(String(password));

    const registration = await prisma.pendingRegistration.create({
      data: {
        name: normalizedName,
        rcStudentId: normalizedRcStudentId,
        email: normalizedEmail,
        dob: parsedDob,
        passwordHash,
      },
    });

    console.log("REGISTRATION CREATED:", registration.id);

    return res.status(201).json({
      success: true,
      id: registration.id,
      name: registration.name,
      rcStudentId: registration.rcStudentId,
      email: registration.email,
      dob: registration.dob,
      status: registration.status,
      message: "Registration submitted successfully.",
    });
  } catch (error) {
    console.error("REGISTRATION ERROR:", error);

    return res.status(500).json({
      error:
        error instanceof Error
          ? error.message
          : "Registration failed.",
    });
  }
});

export default router;

