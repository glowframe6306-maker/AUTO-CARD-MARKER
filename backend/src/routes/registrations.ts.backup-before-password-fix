import express from "express";
import { Router } from "express";
import prisma from "../prisma";
import { hashPassword } from "../utils/auth";
import { authenticate, AuthorizedRequest } from "../middleware/authMiddleware";

const router = Router();

// Create a new pending registration (JSON payload expected).
router.post("/", async (req, res) => {
  try {
    const { name, rcStudentId, email, dob, rcNumber } = req.body ?? {};

    // normalize incoming fields
    const normalizedName = typeof name === "string" ? name.trim() : "";
    const normalizedRcStudentId = typeof rcStudentId === "string" ? rcStudentId.trim() : String(rcStudentId || "");
    const normalizedEmail = typeof email === "string" ? email.trim().toLowerCase() : "";
    const normalizedDob = typeof dob === "string" ? dob.trim() : dob;

    // Log which keys were received (do NOT log values or sensitive data).
    console.log("REGISTRATION BODY KEYS:", Object.keys(req.body || {}), "content-type:", req.headers["content-type"]);

    const missingFields: string[] = [];
    if (!name) missingFields.push("name");
    if (!rcStudentId) missingFields.push("rcStudentId");
    if (!email) missingFields.push("email");
    if (!dob) missingFields.push("dob");
    if (!rcNumber) missingFields.push("rcNumber");

    if (missingFields.length > 0) {
      return res.status(400).json({
        success: false,
        error: "Missing required registration fields.",
        code: "MISSING_FIELDS",
        missingFields,
      });
    }

    const parsedDob = new Date(normalizedDob);

    if (!normalizedName || !normalizedRcStudentId || !normalizedEmail) {
      return res.status(400).json({
        error: "All registration fields are required.",
      });
    }

    if (Number.isNaN(parsedDob.getTime())) {
      return res.status(400).json({
        error: "Invalid date of birth.",
      });
    }

    const [existingUserByAccount, existingUserByEmail, existingMember, existingPending] = await Promise.all([
      prisma.user.findUnique({ where: { accountId: normalizedRcStudentId }, select: { id: true } }),
      prisma.user.findUnique({ where: { email: normalizedEmail }, select: { id: true } }),
      prisma.memberProfile.findUnique({ where: { memberId: normalizedRcStudentId }, select: { id: true } }),
      prisma.pendingRegistration.findUnique({ where: { rcStudentId: normalizedRcStudentId }, select: { id: true, status: true } }),
    ]);

    if (existingUserByAccount || existingMember || existingPending) {
      return res.status(409).json({
        success: false,
        error: "An account or pending registration with that RC Student ID already exists.",
        code: "DUPLICATE_REGISTRATION",
      });
    }

    if (existingUserByEmail) {
      return res.status(409).json({
        success: false,
        error: "Email already in use.",
        code: "DUPLICATE_REGISTRATION",
      });
    }

    const passwordHash = await hashPassword(String(rcNumber));

    // Create pending registration; protect DB errors and return safe structured error if creation fails.
    let registration;
    try {
      registration = await prisma.pendingRegistration.create({
        data: {
          name: normalizedName,
          rcStudentId: normalizedRcStudentId,
          email: normalizedEmail,
          dob: parsedDob,
          passwordHash,
          imagePath: "",
        },
      });
    } catch (err: any) {
      console.error("PENDING REGISTRATION CREATE ERROR:", err?.message ?? err);
      return res.status(500).json({
        success: false,
        error: "Registration creation failed.",
        code: "REGISTRATION_CREATE_FAILED",
        message: err instanceof Error ? err.message : String(err),
      });
    }

    // Create an approval request for Owners to review this registration
    const requestId = `REG-${Date.now()}-${Math.floor(Math.random() * 100000)}`;

    await prisma.approvalRequest.create({
      data: {
        requestId,
        requesterId: null,
        requesterRole: "PUBLIC",
        actionType: "CREATE",
        targetType: "REGISTRATION",
        targetId: String(registration.id),
        oldValue: {},
        newValue: {
          name: registration.name,
          rcStudentId: registration.rcStudentId,
          email: registration.email,
          dob: registration.dob.toISOString(),
          imagePath: registration.imagePath,
        },
        reason: "New member registration",
      },
    });

    console.log("REGISTRATION CREATED:", registration.id);

    return res.status(201).json({
      success: true,
      id: registration.id,
      name: registration.name,
      rcStudentId: registration.rcStudentId,
      email: registration.email,
      dob: registration.dob,
      status: registration.status,
      message: "Registration submitted successfully.",
    });
  } catch (error) {
    console.error("REGISTRATION ERROR:", error);
    return res.status(500).json({ error: error instanceof Error ? error.message : "Registration failed." });
  }
});

// Owner-only: get registration details
router.get("/:id", authenticate, async (req: AuthorizedRequest, res) => {
  try {
    if (!req.user?.isOwner) return res.status(403).json({ error: "Forbidden" });

    const id = Number(req.params.id);
    if (!Number.isInteger(id) || id <= 0) return res.status(400).json({ error: "Invalid registration ID." });

    const registration = await prisma.pendingRegistration.findUnique({ where: { id } });
    if (!registration) return res.status(404).json({ error: "Registration not found." });

    return res.json({
      id: registration.id,
      name: registration.name,
      rcStudentId: registration.rcStudentId,
      email: registration.email,
      dob: registration.dob,
      imagePath: registration.imagePath,
      status: registration.status,
      createdAt: registration.createdAt,
      approvedAt: registration.approvedAt,
    });
  } catch (error) {
    console.error("REGISTRATION DETAILS ERROR:", error);
    return res.status(500).json({ error: "Failed to retrieve registration." });
  }
});

// Owner-only: get registration image (if any)
router.get("/:id/image", authenticate, async (req: AuthorizedRequest, res) => {
  try {
    if (!req.user?.isOwner) return res.status(403).json({ error: "Forbidden" });

    const id = Number(req.params.id);
    if (!Number.isInteger(id) || id <= 0) return res.status(400).json({ error: "Invalid registration ID." });

    const registration = await prisma.pendingRegistration.findUnique({ where: { id }, select: { imagePath: true } });
    if (!registration) return res.status(404).json({ error: "Registration not found." });

    if (!registration.imagePath) {
      return res.status(404).json({ error: "No verification image was submitted." });
    }

    // If image support is added later, serve the file here. For now, return 404.
    return res.status(404).json({ error: "Verification image not available." });
  } catch (error) {
    console.error("REGISTRATION IMAGE ERROR:", error);
    return res.status(500).json({ error: "Failed to retrieve verification image." });
  }
});

export default router;



