generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int                         @id @default(autoincrement())
  accountId                  String                      @unique
  email                      String?                     @unique
  fullName                   String
  passwordHash               String
    secondaryPasswordHash      String?
  status                     UserStatus                  @default(ACTIVE)
  isOwner                    Boolean                     @default(false)
  forcePasswordReset         Boolean                     @default(true)
  failedLoginAttempts        Int                         @default(0)
  lockedUntil                DateTime?
  lastFailedLoginAt          DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  verificationPolicy         VerificationChoice          @default(AT_THIS_TIME)
  alwaysAllowSecurityVerification Boolean                 @default(false)
  latestDeviceIdentifier     String?                     @db.Text
  svCompletionPopupDisabled  Boolean                     @default(false)
  svRunningPopupDisabled     Boolean                     @default(false)
  requests                   ApprovalRequest[]           @relation("requester")
  reviews                    ApprovalRequest[]           @relation("approver")
  auditLogs                  AuditLog[]                  @relation("actorLogs")
  backups                    Backup[]
  cameraVerifications        CameraVerificationSession[] @relation("requestedBy")
  cameraVerificationSessions CameraVerificationSession[] @relation("cameraVerificationSessions")
  uploadedCardUploads        CardUpload[]                @relation("uploadedBy")
  collectionSessions         CollectionSession[]         @relation("collectionSessions")
  devices                    Device[]
  memberProfile              MemberProfile?
  closedMonthlyRecords       MonthlyRecord[]             @relation("closedMonthlyRecords")
  notifications              Notification[]
  ocrReviews                 OcrReview[]                 @relation("ocrReviews")
  paymentsRecorded           Payment[]                   @relation("recordedBy")
  paymentRequestProcessing   PaymentRequest[]            @relation("paymentRequestProcessor")
  paymentRequestReviews      PaymentRequest[]            @relation("paymentRequestReviewer")
  receiptsIssued             Receipt[]                   @relation("issuedBy")
  securityEvents             SecurityEvent[]
  roles                      UserRole[]
  pointTransactions          PointTransaction[]
  awardedPoints              PointTransaction[] @relation("awardedBy")
  chatParticipants            ChatParticipant[]
  chatMessages                ChatMessage[] @relation("chatMessageSender")
  chatReactions               ChatMessageReaction[]
  chatStars                   ChatMessageStar[]
  chatNotifications           ChatNotification[]
  chatPins                    ChatMessagePin[] @relation("chatMessagePins")
  chatDeliveries              ChatMessageDelivery[]
  leaderboardResets           LeaderboardReset[] @relation("leaderboardResetOwner")
  chatClears                  ChatClearState[] @relation("chatClearOwner")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  label       String
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])
  user   User @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model MemberProfile {
  id              Int              @id @default(autoincrement())
  memberId        String           @unique
  userId          Int              @unique
  fullName        String
  grade           String
  position        String
  status          MemberStatus     @default(ACTIVE)
  photoUrl        String?
  customFields    Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  cardUploads     CardUpload[]
  user            User             @relation(fields: [userId], references: [id])
  payments        Payment[]
  paymentRequests PaymentRequest[]
  receipts        Receipt[]
}

model AcademicYear {
  id             Int              @id @default(autoincrement())
  year           Int              @unique
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  monthlyRecords MonthlyRecord[]
  payments       Payment[]
  PaymentRequest PaymentRequest[]
}

model MonthlyRecord {
  id             Int          @id @default(autoincrement())
  academicYearId Int
  month          Int
  isClosed       Boolean      @default(false)
  closedAt       DateTime?
  closedById     Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  name           String       @default("")
  paymentAmount  Int          @default(800)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  closedBy       User?        @relation("closedMonthlyRecords", fields: [closedById], references: [id])

  @@unique([academicYearId, month])
}

model Payment {
  id             Int           @id @default(autoincrement())
  memberId       Int
  academicYearId Int
  month          Int
  paymentAmount  Int
  paymentDate    DateTime
  week1          Boolean       @default(false)
  week2          Boolean       @default(false)
  week3          Boolean       @default(false)
  week4          Boolean       @default(false)
  totalWeeks     Int
  recordedById   Int
  status         PaymentStatus @default(COMPLETED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  notes          String?
  auditLogs      AuditLog[]    @relation("paymentTarget")
  cardUpload     CardUpload?   @relation("paymentCardUpload")
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  member         MemberProfile @relation(fields: [memberId], references: [id])
  recordedBy     User          @relation("recordedBy", fields: [recordedById], references: [id])
  receipt        Receipt?

  @@index([memberId])
  @@index([paymentDate])
  @@index([month])
}

model PaymentRequest {
  id             Int                  @id @default(autoincrement())
  memberId       Int
  academicYearId Int
  requestedMonth Int
  amount         Int
  fullName       String
  grade          String
  note           String?
  cardUploadId   Int?                 @unique
  ocrResultId    Int?                 @unique
  status         PaymentRequestStatus @default(PENDING_REVIEW)
  submittedAt    DateTime             @default(now())
  reviewedById   Int?
  reviewedAt     DateTime?
  reviewerNotes  String?
  processedById  Int?
  processedAt    DateTime?
  processedMonth Int?
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id])
  cardUpload     CardUpload?          @relation(fields: [cardUploadId], references: [id])
  member         MemberProfile        @relation(fields: [memberId], references: [id])
  ocrResult      OcrResult?           @relation(fields: [ocrResultId], references: [id])
  processedBy    User?                @relation("paymentRequestProcessor", fields: [processedById], references: [id])
  reviewedBy     User?                @relation("paymentRequestReviewer", fields: [reviewedById], references: [id])

  @@index([memberId])
  @@index([status])
}

model PointTransaction {
  id          Int                 @id @default(autoincrement())
  userId      Int
  category    LeaderboardCategory
  points      Int
  direction   PointDirection
  actionType  PointActionType
  awardedById Int?
  eventKey    String?             @unique
  description String?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id])
  awardedBy   User?               @relation("awardedBy", fields: [awardedById], references: [id])

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model LeaderboardReset {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  createdById Int
  createdBy   User     @relation("leaderboardResetOwner", fields: [createdById], references: [id])

  @@index([createdAt])
}

model MonthlyWinner {
  id        Int      @id @default(autoincrement())
  name      String
  rcNumber  String
  month     Int
  year      Int
  createdAt DateTime @default(now())

  @@index([year, month])
  @@index([createdAt])
}

model ChatClearState {
  id          Int      @id
  clearedAt   DateTime @default(now())
  clearedById Int
  clearedBy   User     @relation("chatClearOwner", fields: [clearedById], references: [id])
}

model ChatConversation {
  id           Int                  @id @default(autoincrement())
  type         ChatConversationType
  title        String?
  directKey    String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([type, updatedAt])
}

model ChatParticipant {
  id             Int              @id @default(autoincrement())
  conversationId Int
  userId         Int
  lastReadAt     DateTime?
  joinedAt       DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String           @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  replyToId      Int?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("chatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo        ChatMessage?     @relation("chatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]    @relation("chatMessageReplies")
  reactions      ChatMessageReaction[]
  stars          ChatMessageStar[]
  pins           ChatMessagePin[]
  attachments    ChatMessageAttachment[]
  deliveries     ChatMessageDelivery[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model ChatMessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  reaction  String
  createdAt DateTime @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@index([messageId])
}

model ChatMessageStar {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  createdAt DateTime @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model ChatMessagePin {
  id        Int      @id @default(autoincrement())
  messageId Int
  pinnedById Int
  createdAt DateTime @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy  User @relation("chatMessagePins", fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([messageId])
}

model ChatMessageAttachment {
  id           Int      @id @default(autoincrement())
  messageId    Int
  fileName     String
  storagePath  String
  mimeType     String
  fileSize     Int
  createdAt    DateTime @default(now())
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatMessageDelivery {
  id          Int      @id @default(autoincrement())
  messageId   Int
  userId      Int
  deliveredAt DateTime?
  readAt      DateTime?
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model ChatNotification {
  id             Int      @id @default(autoincrement())
  userId         Int
  conversationId Int
  messageId      Int?
  kind           String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Receipt {
  id            Int           @id @default(autoincrement())
  receiptNumber String        @unique
  paymentId     Int?          @unique
  memberId      Int
  issuedById    Int
  issuedAt      DateTime      @default(now())
  amount        Int
  weeksPaid     Int
  month         Int
  receiptQrUrl  String?
  pdfPath       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  issuedBy      User          @relation("issuedBy", fields: [issuedById], references: [id])
  member        MemberProfile @relation(fields: [memberId], references: [id])
  payment       Payment?      @relation(fields: [paymentId], references: [id])

  @@index([memberId])
}

model CardUpload {
  id               Int             @id @default(autoincrement())
  uploaderId       Int
  memberId         Int?
  paymentId        Int?            @unique
  originalName     String
  filePath         String
  status           String          @default("PENDING_REVIEW")
  duplicateWarning Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  member           MemberProfile?  @relation(fields: [memberId], references: [id])
  payment          Payment?        @relation("paymentCardUpload", fields: [paymentId], references: [id])
  uploader         User            @relation("uploadedBy", fields: [uploaderId], references: [id])
  ocrResult        OcrResult?
  paymentRequests  PaymentRequest?
}

model OcrResult {
  id               Int             @id @default(autoincrement())
  cardUploadId     Int             @unique
  detectedName     String?
  detectedMemberId Int?
  detectedMonth    Int?
  detectedAmount   Int?
  detectedDate     DateTime?
  confidence       Float           @default(0)
  rawText          String?
  attempts         Int             @default(1)
  status           String          @default("REVIEW")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  cardUpload       CardUpload      @relation(fields: [cardUploadId], references: [id])
  review           OcrReview?
  paymentRequests  PaymentRequest?
}

model OcrReview {
  id              Int       @id @default(autoincrement())
  ocrResultId     Int       @unique
  reviewerId      Int
  approved        Boolean
  comments        String?
  correctedName   String?
  correctedMonth  Int?
  correctedAmount Int?
  reviewedAt      DateTime  @default(now())
  ocrResult       OcrResult @relation(fields: [ocrResultId], references: [id])
  reviewer        User      @relation("ocrReviews", fields: [reviewerId], references: [id])
}

model ApprovalRequest {
  id            Int            @id @default(autoincrement())
  requestId     String         @unique
  requesterId   Int?
  requesterRole String
  actionType    String
  targetType    String
  targetId      String
  oldValue      Json
  newValue      Json
  reason        String
  status        ApprovalStatus @default(PENDING)
  reviewerId    Int?
  reviewReason  String?
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogId    Int?           @unique
  auditLog      AuditLog?      @relation("approvalLog", fields: [auditLogId], references: [id])
  requester     User?          @relation("requester", fields: [requesterId], references: [id])
  reviewer      User?          @relation("approver", fields: [reviewerId], references: [id])

  @@index([status])
}

model AuditLog {
  id              Int              @id @default(autoincrement())
  actorId         Int
  actorRole       String
  action          String
  targetType      String
  targetId        String
  oldValue        Json?
  newValue        Json?
  status          String
  reason          String?
  createdAt       DateTime         @default(now())
  paymentId       Int?
  approvalRequest ApprovalRequest? @relation("approvalLog")
  actor           User             @relation("actorLogs", fields: [actorId], references: [id])
  payment         Payment?         @relation("paymentTarget", fields: [paymentId], references: [id])
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  type        String
  title       String
  message     String
  metadata    Json?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id])
}

model Announcement {
  id             Int       @id @default(autoincrement())
  title          String
  content        String
  scheduledAt    DateTime?
  publishedAt    DateTime?
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?
  isPinned       Boolean   @default(false)
  targetGrade    String?
  targetMemberId String?
  targetType     String    @default("ALL")
}

model Device {
  id                    Int       @id @default(autoincrement())
  userId                Int
  deviceName            String
  deviceId              String?   @unique
  platform              String
  browser               String
  ipAddress             String?
  trusted               Boolean   @default(false)
  lastActive            DateTime  @default(now())
  lastLoginAt           DateTime?
  isLatest              Boolean   @default(false)
  pushToken             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deviceIdentifier      String?   @unique
  svCameraPermission    Boolean?
  svLastPermissionCheck DateTime?
  svMicPermission       Boolean?
  svPermissionDeniedAt  DateTime?
  user                  User      @relation(fields: [userId], references: [id])

  @@index([userId, isLatest])
  @@index([userId, lastLoginAt])
}

model SecurityEvent {
  id         Int      @id @default(autoincrement())
  userId     Int
  eventType  String
  ipAddress  String?
  deviceName String?
  platform   String?
  browser    String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model CameraVerificationSession {
  id                     Int                @id @default(autoincrement())
  userId                 Int
  requestedById          Int
  permissionChoice       VerificationChoice
  status                 VerificationStatus @default(REQUESTED)
  mediaPath              String?
  notes                  String?
  requestedAt            DateTime           @default(now())
  expiresAt              DateTime?
  completedAt            DateTime?
  durationSeconds        Int?
  targetDeviceIdentifier String?
  requestedBy            User               @relation("requestedBy", fields: [requestedById], references: [id])
  user                   User               @relation("cameraVerificationSessions", fields: [userId], references: [id])
}

model PaymentRule {
  id            Int      @id @default(autoincrement())
  weeklyAmount  Int      @default(50)
  weeksPerMonth Int      @default(4)
  updatedAt     DateTime @default(now())
  active        Boolean  @default(true)
}

model CollectionSession {
  id              Int              @id @default(autoincrement())
  ownerId         Int
  expectedAmount  Int
  collectedAmount Int
  difference      Int
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  status          CollectionStatus @default(OPEN)
  owner           User             @relation("collectionSessions", fields: [ownerId], references: [id])
}

model Backup {
  id            Int       @id @default(autoincrement())
  initiatedById Int
  filePath      String
  status        String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  initiatedBy   User      @relation(fields: [initiatedById], references: [id])
}

model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model PendingRegistration {
  id           Int                @id @default(autoincrement())
  name         String
  rcStudentId  String             @unique
  email        String
  dob          DateTime
  passwordHash String
  imagePath    String?
  status       RegistrationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  approvedById Int?
  approvedAt   DateTime?
}

enum PaymentRequestStatus {
  PENDING_REVIEW
  AWAITING_MANUAL_SELECTION
  DENIED
  COMPLETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
  PENDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REVIEW
  CORRECTED
  FAILED
  REFUNDED
}

enum LeaderboardCategory {
  MONTHLY_PAYMENT
  DAILY_APP_VISIT
  DISCIPLINE
  MEETING_ATTENDANCE
  VOLUNTEER_ACTIVITY
  ASSIGNED_TASK
  HELPING_OTHER_MEMBERS
  CREATIVE_IDEA_SUBMISSION
  APPROVED_PROJECT_PROPOSAL
  EXCELLENT_TEAMWORK
  RESPECT_OTHERS
  TALKING_IN_ENGLISH
}

enum PointActionType {
  AWARD
  REDUCTION
  AUTOMATIC
}

enum PointDirection {
  POSITIVE
  NEGATIVE
}

enum VerificationChoice {
  ALWAYS
  AT_THIS_TIME
  NO
}

enum VerificationStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum CollectionStatus {
  OPEN
  CLOSED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ChatConversationType {
  DIRECT
  OFFICIAL_ANNOUNCEMENT
}
