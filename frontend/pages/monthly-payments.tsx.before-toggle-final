import { useEffect, useMemo, useState } from "react";
import { authFetch, getApiUrl } from "../lib/api";
import { useAuth } from "../lib/useAuth";

const monthNames = [
  "January","February","March","April","May","June",
  "July","August","September","October","November","December",
];

export default function MonthlyPayments() {
  const { user, isLoading } = useAuth();

  const [months, setMonths] = useState<any[]>([]);
  const [years, setYears] = useState<any[]>([]);
  const [members, setMembers] = useState<any[]>([]);
  const [selectedMember, setSelectedMember] = useState<any>(null);

  const [loading, setLoading] = useState(true);
  const [membersLoading, setMembersLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [selectedYear, setSelectedYear] = useState<string>("");

  const [showAdd, setShowAdd] = useState(false);
  const [form, setForm] = useState({
    academicYearId: "",
    month: "1",
    paymentAmount: "800",
  });

  async function load() {
    try {
      setLoading(true);
      setError(null);

      const [monthsRes, yearsRes] = await Promise.all([
        authFetch(`${getApiUrl()}/api/months`),
        authFetch(`${getApiUrl()}/api/system/academic-years`),
      ]);

      if (!monthsRes.ok) {
        const body = await monthsRes.json().catch(() => ({}));
        throw new Error(body?.error || "Unable to load monthly payments.");
      }

      const monthData = await monthsRes.json();
      setMonths(Array.isArray(monthData) ? monthData : []);

      if (yearsRes.ok) {
        const yearData = await yearsRes.json();
        const list = Array.isArray(yearData)
          ? yearData
          : yearData?.value || [];

        setYears(list);

        if (!selectedYear && list.length) {
          const current = list.find((y: any) => y.isCurrent) || list[0];
          if (current) setSelectedYear(String(current.id));
        }
      }
    } catch (err: any) {
      setError(err?.message || "Unable to load monthly payments.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    if (isLoading) return;

    if (!user) {
      window.location.href = "/";
      return;
    }

    if (user.isOwner !== true) {
      window.location.href = "/member-dashboard";
      return;
    }

    load();
  }, [user, isLoading]);

  const filteredMonths = useMemo(() => {
    if (!selectedYear) return months;

    return months.filter(
      (m) => String(m.academicYearId) === String(selectedYear)
    );
  }, [months, selectedYear]);

  async function loadMembers(month: any) {
    try {
      setMembersLoading(true);
      setError(null);

      const response = await authFetch(
        `${getApiUrl()}/api/months/${month.id}/members`
      );

      const body = await response.json().catch(() => []);

      if (!response.ok) {
        throw new Error(body?.error || "Unable to load members.");
      }

      setMembers(Array.isArray(body) ? body : []);
    } catch (err: any) {
      setError(err?.message || "Unable to load members.");
    } finally {
      setMembersLoading(false);
    }
  }

  async function openMonth(month: any) {
    setSelectedMember({
      type: "month",
      month,
    });

    await loadMembers(month);
  }

  async function updateMemberStatus(
    month: any,
    member: any,
    status: "PAID" | "PENDING"
  ) {
    try {
      setError(null);

      const response = await authFetch(
        `${getApiUrl()}/api/months/${month.id}/members/${member.id}/status`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ status }),
        }
      );

      const body = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          body?.error || "Unable to update payment status."
        );
      }

      setMembers((current) =>
        current.map((item) =>
          item.id === member.id
            ? {
                ...item,
                status,
                paymentAmount:
                  status === "PAID"
                    ? Number(month.paymentAmount || 0)
                    : 0,
              }
            : item
        )
      );

      await load();
    } catch (err: any) {
      setError(err?.message || "Unable to update payment status.");
    }
  }

  async function addMonth() {
    try {
      setError(null);

      if (!form.academicYearId) {
        throw new Error("Select an academic year.");
      }

      const response = await authFetch(`${getApiUrl()}/api/months`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          academicYearId: Number(form.academicYearId),
          month: Number(form.month),
          name: `${monthNames[Number(form.month) - 1]} ${
            years.find(
              (y: any) => Number(y.id) === Number(form.academicYearId)
            )?.year || ""
          }`.trim(),
          paymentAmount: Number(form.paymentAmount),
        }),
      });

      const body = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(body?.error || "Unable to create month.");
      }

      setShowAdd(false);

      setForm({
        academicYearId: form.academicYearId,
        month: "1",
        paymentAmount: "800",
      });

      await load();
    } catch (err: any) {
      setError(err?.message || "Unable to create month.");
    }
  }

  if (isLoading || loading) {
    return (
      <div className="rounded-3xl border border-slate-200 bg-white p-8">
        <p className="text-sm text-slate-600">
          Loading Monthly Payments...
        </p>
      </div>
    );
  }

  return (
    <div className="space-y-6">

      <header className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div className="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p className="text-sm font-semibold uppercase tracking-[0.22em] text-brand-600">
              OWNER
            </p>

            <h1 className="mt-2 text-3xl font-bold text-slate-950">
              Monthly Payments
            </h1>

            <p className="mt-2 text-sm text-slate-600">
              Manage every active member's monthly payment status.
            </p>
          </div>

          <div className="flex flex-wrap gap-3">
            <select
              value={selectedYear}
              onChange={(e) => setSelectedYear(e.target.value)}
              className="rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold"
            >
              <option value="">All Academic Years</option>

              {years.map((year) => (
                <option key={year.id} value={year.id}>
                  {year.name || year.year}
                </option>
              ))}
            </select>

            <button
              onClick={() => setShowAdd(true)}
              className="rounded-2xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-700"
            >
              + New Month
            </button>
          </div>
        </div>
      </header>

      {error && (
        <div className="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          {error}
        </div>
      )}

      {showAdd && (
        <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 className="text-xl font-bold text-slate-950">
            Create New Month
          </h2>

          <p className="mt-1 text-sm text-slate-500">
            New active members will automatically appear as PENDING.
          </p>

          <div className="mt-5 grid gap-4 md:grid-cols-3">

            <select
              value={form.academicYearId}
              onChange={(e) =>
                setForm({
                  ...form,
                  academicYearId: e.target.value,
                })
              }
              className="rounded-2xl border border-slate-300 px-4 py-3"
            >
              <option value="">Select Academic Year</option>

              {years.map((year) => (
                <option key={year.id} value={year.id}>
                  {year.name || year.year}
                </option>
              ))}
            </select>

            <select
              value={form.month}
              onChange={(e) =>
                setForm({
                  ...form,
                  month: e.target.value,
                })
              }
              className="rounded-2xl border border-slate-300 px-4 py-3"
            >
              {monthNames.map((name, index) => (
                <option key={name} value={index + 1}>
                  {name}
                </option>
              ))}
            </select>

            <input
              type="number"
              min="0"
              value={form.paymentAmount}
              onChange={(e) =>
                setForm({
                  ...form,
                  paymentAmount: e.target.value,
                })
              }
              placeholder="Payment amount"
              className="rounded-2xl border border-slate-300 px-4 py-3"
            />
          </div>

          <div className="mt-5 flex gap-3">
            <button
              onClick={addMonth}
              className="rounded-2xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white"
            >
              Create Month
            </button>

            <button
              onClick={() => setShowAdd(false)}
              className="rounded-2xl border border-slate-300 px-5 py-3 text-sm font-semibold"
            >
              Cancel
            </button>
          </div>
        </div>
      )}

      <div className="grid gap-5 md:grid-cols-2 xl:grid-cols-3">

        {filteredMonths.map((month) => (
          <div
            key={month.id}
            className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm"
          >
            <div className="flex items-start justify-between gap-3">
              <div>
                <p className="text-xs font-semibold uppercase tracking-wider text-slate-400">
                  {month.academicYear?.name ||
                    month.academicYear?.year ||
                    "Academic Year"}
                </p>

                <h2 className="mt-1 text-xl font-bold text-slate-950">
                  {month.name}
                </h2>
              </div>

              <span className="rounded-full bg-orange-100 px-3 py-1 text-xs font-bold text-orange-700">
                {month.pendingMembers > 0
                  ? `${month.pendingMembers} PENDING`
                  : "ALL PAID"}
              </span>
            </div>

            <div className="mt-5 grid grid-cols-3 gap-2">

              <div className="rounded-2xl bg-slate-50 p-3">
                <p className="text-xs text-slate-500">Members</p>
                <p className="mt-1 text-xl font-bold">
                  {month.totalMembers || 0}
                </p>
              </div>

              <div className="rounded-2xl bg-green-50 p-3">
                <p className="text-xs text-green-700">Paid</p>
                <p className="mt-1 text-xl font-bold text-green-800">
                  {month.paidMembers || 0}
                </p>
              </div>

              <div className="rounded-2xl bg-orange-50 p-3">
                <p className="text-xs text-orange-700">Pending</p>
                <p className="mt-1 text-xl font-bold text-orange-800">
                  {month.pendingMembers || 0}
                </p>
              </div>
            </div>

            <div className="mt-5 rounded-2xl bg-slate-50 p-4">
              <div className="flex justify-between text-sm">
                <span className="text-slate-500">
                  Monthly Amount
                </span>

                <strong>
                  Rs. {Number(month.paymentAmount || 0).toLocaleString()}
                </strong>
              </div>

              <div className="mt-2 flex justify-between text-sm">
                <span className="text-slate-500">
                  Collected
                </span>

                <strong className="text-green-700">
                  Rs. {Number(month.totalCollected || 0).toLocaleString()}
                </strong>
              </div>

              <div className="mt-2 flex justify-between text-sm">
                <span className="text-slate-500">
                  Pending
                </span>

                <strong className="text-orange-700">
                  Rs. {Number(month.totalPending || 0).toLocaleString()}
                </strong>
              </div>
            </div>

            <button
              onClick={() => openMonth(month)}
              className="mt-5 w-full rounded-2xl bg-slate-950 px-4 py-3 text-sm font-bold text-white hover:bg-slate-800"
            >
              View All Members
            </button>
          </div>
        ))}

        {!filteredMonths.length && (
          <div className="col-span-full rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center">
            <p className="font-semibold text-slate-900">
              No monthly records found.
            </p>
          </div>
        )}
      </div>

      {selectedMember?.type === "month" && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4">

          <div className="max-h-[90vh] w-full max-w-5xl overflow-auto rounded-3xl bg-white p-6 shadow-2xl">

            <div className="flex items-start justify-between gap-4">
              <div>
                <p className="text-sm font-semibold uppercase tracking-wider text-brand-600">
                  {selectedMember.month.academicYear?.name ||
                    selectedMember.month.academicYear?.year}
                </p>

                <h2 className="mt-1 text-2xl font-bold">
                  {selectedMember.month.name}
                </h2>

                <p className="mt-1 text-sm text-slate-500">
                  All active members and payment status
                </p>
              </div>

              <button
                onClick={() => setSelectedMember(null)}
                className="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold"
              >
                Close
              </button>
            </div>

            {membersLoading ? (
              <div className="py-12 text-center text-sm text-slate-500">
                Loading members...
              </div>
            ) : (
              <div className="mt-6 space-y-3">

                {members.map((member) => (
                  <div
                    key={member.id}
                    className="rounded-2xl border border-slate-200 p-4"
                  >
                    <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

                      <button
                        onClick={() => setSelectedMember({
                          type: "member",
                          month: selectedMember.month,
                          member,
                        })}
                        className="text-left"
                      >
                        <p className="text-lg font-bold text-slate-950">
                          {member.fullName}
                        </p>

                        <p className="mt-1 text-sm font-semibold text-brand-600">
                          RC ID: {member.memberId}
                        </p>

                        <p className="mt-1 text-xs text-slate-500">
                          {member.grade || "Grade not available"}
                          {" • "}
                          {member.position || "Position not available"}
                        </p>
                      </button>

                      <div className="flex flex-wrap items-center gap-2">

                        <span
                          className={`rounded-full px-3 py-2 text-xs font-bold ${
                            member.status === "PAID"
                              ? "bg-green-100 text-green-700"
                              : "bg-orange-100 text-orange-700"
                          }`}
                        >
                          {member.status}
                        </span>

                        {member.status === "PENDING" ? (
                          <button
                            onClick={() =>
                              updateMemberStatus(
                                selectedMember.month,
                                member,
                                "PAID"
                              )
                            }
                            className="rounded-xl bg-green-600 px-4 py-2 text-xs font-bold text-white hover:bg-green-700"
                          >
                            Mark PAID
                          </button>
                        ) : (
                          <button
                            onClick={() =>
                              updateMemberStatus(
                                selectedMember.month,
                                member,
                                "PENDING"
                              )
                            }
                            className="rounded-xl bg-orange-500 px-4 py-2 text-xs font-bold text-white hover:bg-orange-600"
                          >
                            Mark PENDING
                          </button>
                        )}
                      </div>
                    </div>
                  </div>
                ))}

              </div>
            )}
          </div>
        </div>
      )}

      {selectedMember?.type === "member" && (
        <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/60 p-4">

          <div className="w-full max-w-2xl rounded-3xl bg-white p-7 shadow-2xl">

            <div className="flex items-start justify-between">
              <div>
                <p className="text-xs font-bold uppercase tracking-wider text-brand-600">
                  MEMBER DETAILS
                </p>

                <h2 className="mt-2 text-2xl font-bold">
                  {selectedMember.member.fullName}
                </h2>
              </div>

              <button
                onClick={() =>
                  setSelectedMember({
                    type: "month",
                    month: selectedMember.month,
                  })
                }
                className="rounded-xl border px-4 py-2 text-sm"
              >
                Back
              </button>
            </div>

            <div className="mt-6 grid gap-3 sm:grid-cols-2">

              <div className="rounded-2xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Full Name</p>
                <p className="mt-1 font-bold">
                  {selectedMember.member.fullName}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">RC ID</p>
                <p className="mt-1 font-bold">
                  {selectedMember.member.memberId}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Grade</p>
                <p className="mt-1 font-bold">
                  {selectedMember.member.grade || "N/A"}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Position</p>
                <p className="mt-1 font-bold">
                  {selectedMember.member.position || "N/A"}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Email</p>
                <p className="mt-1 break-all font-bold">
                  {selectedMember.member.email || "N/A"}
                </p>
              </div>

              <div className="rounded-2xl bg-slate-50 p-4">
                <p className="text-xs text-slate-500">Account ID</p>
                <p className="mt-1 break-all font-bold">
                  {selectedMember.member.accountId || "N/A"}
                </p>
              </div>

            </div>

            <div className="mt-5 rounded-2xl border border-slate-200 p-4">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-semibold">
                    {selectedMember.month.name}
                  </p>

                  <p className="text-xs text-slate-500">
                    Monthly payment status
                  </p>
                </div>

                <span
                  className={`rounded-full px-3 py-2 text-xs font-bold ${
                    selectedMember.member.status === "PAID"
                      ? "bg-green-100 text-green-700"
                      : "bg-orange-100 text-orange-700"
                  }`}
                >
                  {selectedMember.member.status}
                </span>
              </div>

              <div className="mt-4 flex gap-2">
                <button
                  onClick={async () => {
                    await updateMemberStatus(
                      selectedMember.month,
                      selectedMember.member,
                      "PAID"
                    );

                    setSelectedMember(null);
                  }}
                  className="flex-1 rounded-xl bg-green-600 px-4 py-3 text-sm font-bold text-white"
                >
                  PAID
                </button>

                <button
                  onClick={async () => {
                    await updateMemberStatus(
                      selectedMember.month,
                      selectedMember.member,
                      "PENDING"
                    );

                    setSelectedMember(null);
                  }}
                  className="flex-1 rounded-xl bg-orange-500 px-4 py-3 text-sm font-bold text-white"
                >
                  PENDING
                </button>
              </div>
            </div>

          </div>
        </div>
      )}
    </div>
  );
}

