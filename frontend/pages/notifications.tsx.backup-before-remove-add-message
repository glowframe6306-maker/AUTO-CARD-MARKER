import { useEffect, useState } from "react";
import { authFetch, fetcher, getApiUrl } from "../lib/api";

export default function Notifications() {
  const [notifications, setNotifications] = useState<any[]>([]);
  const [error, setError] = useState<string | null>(null);

  const [showAddMessage, setShowAddMessage] = useState(false);
  const [recipient, setRecipient] = useState<"OWNER" | "ADMIN" | "">("");
  const [message, setMessage] = useState("");
  const [sending, setSending] = useState(false);

  async function loadNotifications() {
    try {
      const data = await fetcher(`${getApiUrl()}/api/notifications`);
      setNotifications(data);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to load notifications.");
    }
  }

  useEffect(() => {
    void loadNotifications();
  }, []);

  async function markRead(id: number) {
    try {
      await authFetch(`${getApiUrl()}/api/notifications/read/${id}`, {
        method: "POST",
      });

      setNotifications((current) =>
        current.map((item) =>
          item.id === id ? { ...item, read: true } : item
        )
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Unable to mark notification read."
      );
    }
  }

  async function sendMessage() {
    if (!recipient) {
      setError("Please select a recipient.");
      return;
    }

    if (!message.trim()) {
      setError("Please type a message.");
      return;
    }

    setSending(true);
    setError(null);

    try {
      await authFetch(`${getApiUrl()}/api/notifications/send`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          recipient,
          message: message.trim(),
        }),
      });

      setMessage("");
      setRecipient("");
      setShowAddMessage(false);

      await loadNotifications();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Unable to send message."
      );
    } finally {
      setSending(false);
    }
  }

  return (
    <div className="space-y-6">
      <header className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div className="flex items-center justify-between gap-4">
          <div>
            <h1 className="text-2xl font-semibold text-slate-950">
              Notifications
            </h1>
            <p className="mt-2 text-sm text-slate-600">
              Recent system alerts and member notifications.
            </p>
          </div>

          <button
            type="button"
            className="button"
            onClick={() => {
              setShowAddMessage((current) => !current);
              setError(null);
            }}
          >
            Add a Message
          </button>
        </div>
      </header>

      {showAddMessage && (
        <section className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 className="text-lg font-semibold text-slate-950">
            Add a Message
          </h2>

          {!recipient ? (
            <div className="mt-5 grid gap-3 sm:grid-cols-2">
              <button
                type="button"
                className="button"
                onClick={() => setRecipient("ADMIN")}
              >
                ADMIN
              </button>

              <button
                type="button"
                className="button"
                onClick={() => setRecipient("OWNER")}
              >
                OWNER
              </button>
            </div>
          ) : (
            <div className="mt-5 space-y-4">
              <div className="text-sm font-semibold text-slate-700">
                Recipient: {recipient}
              </div>

              <textarea
                value={message}
                onChange={(event) => setMessage(event.target.value)}
                placeholder="Type Message"
                rows={5}
                className="w-full rounded-2xl border border-slate-300 p-4 text-sm outline-none focus:border-slate-500"
              />

              <div className="flex gap-3">
                <button
                  type="button"
                  className="button"
                  onClick={sendMessage}
                  disabled={sending}
                >
                  {sending ? "Sending..." : "Send"}
                </button>

                <button
                  type="button"
                  className="button"
                  onClick={() => {
                    setRecipient("");
                    setMessage("");
                    setError(null);
                  }}
                  disabled={sending}
                >
                  Back
                </button>
              </div>
            </div>
          )}
        </section>
      )}

      {error && (
        <div className="rounded-3xl border border-red-200 bg-red-50 p-6 text-sm text-red-700">
          {error}
        </div>
      )}

      <div className="space-y-4">
        {notifications.length ? (
          notifications.map((notification) => (
            <div
              key={notification.id}
              className={`rounded-3xl border p-6 shadow-sm ${
                notification.read
                  ? "border-slate-200 bg-slate-50"
                  : "border-brand-200 bg-brand-50"
              }`}
            >
              <div className="flex items-start justify-between gap-4">
                <div>
                  <p className="text-sm font-semibold text-slate-950">
                    {notification.title || "Notification"}
                  </p>

                  <p className="mt-2 text-sm text-slate-600">
                    {notification.message ||
                      notification.content ||
                      "No content available."}
                  </p>

                  {notification.metadata?.senderName && (
                    <p className="mt-2 text-xs text-slate-500">
                      From: {notification.metadata.senderName}
                    </p>
                  )}

                  {notification.metadata?.senderAccountId && (
                    <p className="text-xs text-slate-500">
                      Account: {notification.metadata.senderAccountId}
                    </p>
                  )}

                  <p className="mt-1 text-xs text-slate-400">
                    {notification.createdAt
                      ? new Date(notification.createdAt).toLocaleString()
                      : ""}
                  </p>
                </div>

                {!notification.read && (
                  <button
                    onClick={() => markRead(notification.id)}
                    className="button"
                  >
                    Mark read
                  </button>
                )}
              </div>
            </div>
          ))
        ) : (
          <div className="rounded-3xl border border-slate-200 bg-white p-6 text-sm text-slate-600 shadow-sm">
            No notifications at this time.
          </div>
        )}
      </div>
    </div>
  );
}
