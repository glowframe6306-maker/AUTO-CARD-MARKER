import { useEffect, useState } from "react";
import { useAuth } from "../lib/useAuth";
import { authFetch, getApiUrl } from "../lib/api";
import { Users, CreditCard, Wallet, LogIn, LogOut, Bell } from "lucide-react";

export default function Dashboard() {
  const { user, isLoading } = useAuth();
  const [data, setData] = useState<any>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (isLoading) return;

    if (!user) {
      window.location.href = "/";
      return;
    }

    if (user.isOwner !== true) {
      window.location.href = "/member-dashboard";
      return;
    }

    (async () => {
      try {
        const resp = await authFetch(`${getApiUrl()}/api/reports/dashboard`);
        if (!resp.ok) {
          const body = await resp.json().catch(() => ({}));
          throw new Error(body?.error || "Unable to load dashboard.");
        }
        const json = await resp.json();
        setData(json);
      } catch (err: any) {
        setError(err instanceof Error ? err.message : String(err));
      }
    })();
  }, [user, isLoading]);

  function logout() {
    localStorage.removeItem("authToken");
    window.location.href = "/";
  }

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-10 text-slate-950">
      <div className="mx-auto max-w-7xl space-y-8">
        <header className="flex flex-col gap-4 rounded-[32px] border border-slate-200 bg-white p-8 shadow-xl sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p className="text-sm uppercase tracking-[0.24em] text-brand-600">Readers Circle Management</p>
            <h1 className="mt-3 text-3xl font-semibold text-slate-950">AUTO MONTHLY CARD PAYMENT MARKING SYSTEM</h1>
            <p className="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Owner, admin and member dashboards with secure role-based access, OCR card processing, and audit reporting.</p>
          </div>
          <button onClick={logout} className="rounded-2xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-700">Sign out</button>
        </header>

        <section className="grid gap-6">
          {/* Top summary row: Members, Collections, Request Alert */}
          <div className="grid gap-6 md:grid-cols-3">
            {/* Total Members */}
            <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">
              <div className="flex items-start gap-4">
                <div className="rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 p-3 text-white shadow-md">
                  <Users size={28} />
                </div>
                <div className="flex-1">
                  <p className="text-sm uppercase tracking-[0.24em] text-slate-500">Total Members</p>
                  <p className="mt-3 text-4xl font-extrabold text-slate-950">{data?.totalMembers ?? "--"}</p>
                  <p className="mt-1 text-sm text-slate-600">Active Members / Total Members</p>
                </div>
              </div>
            </div>

            {/* Total Collections */}
            <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">
              <div className="flex items-start gap-4">
                <div className="rounded-xl bg-gradient-to-br from-emerald-400 to-yellow-500 p-3 text-white shadow-md">
                  <CreditCard size={28} />
                </div>
                <div className="flex-1">
                  <p className="text-sm uppercase tracking-[0.24em] text-slate-500">Total Collections</p>
                  <p className="mt-3 text-4xl font-extrabold text-slate-900">Rs. {data?.totalCollection ?? "--"}</p>
                  <p className="mt-1 text-sm text-slate-600">Total amounts collected (currency)</p>
                </div>
              </div>
            </div>

            {/* Request Alert */}
            <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">
              <div className="flex items-start gap-4">
                <div className="rounded-xl bg-gradient-to-br from-orange-400 to-red-500 p-3 text-white shadow-md">
                  <Bell size={28} />
                </div>
                <div className="flex-1">
                  <p className="text-sm uppercase tracking-[0.24em] text-slate-500">Request Alert</p>
                  {typeof data?.pendingRequestsCount === "number" ? (
                    data.pendingRequestsCount > 0 ? (
                      <p className="mt-3 text-3xl font-extrabold text-red-600">{data.pendingRequestsCount} Pending</p>
                    ) : (
                      <p className="mt-3 text-3xl font-semibold text-emerald-600">No Pending Requests</p>
                    )
                  ) : (
                    <p className="mt-3 text-sm text-slate-600">No Pending Requests</p>
                  )}
                  <p className="mt-1 text-sm text-slate-600">Only shows presence — manage on Approvals page.</p>
                </div>
              </div>
            </div>
          </div>

          {/* Bottom row: Recent Payments and Recent Login/Logout */}
          <div className="grid gap-6 lg:grid-cols-2">
            {/* Recent Payments */}
            <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-3">
                  <div className="rounded-xl bg-gradient-to-br from-violet-500 to-purple-700 p-3 text-white shadow-md">
                    <CreditCard size={20} />
                  </div>
                  <div>
                    <p className="text-sm uppercase tracking-[0.24em] text-slate-500">Recent Payments</p>
                    <p className="mt-1 text-sm text-slate-600">Latest received payments</p>
                  </div>
                </div>
              </div>

              <div className="mt-6 space-y-3">
                {data?.recentPayments?.length ? (
                  data.recentPayments.map((payment: any) => (
                    <div key={payment.id ?? `${payment.memberId}-${payment.paymentDate}`} className="flex items-center justify-between rounded-2xl border border-slate-100 bg-slate-50 p-3">
                      <div>
                        <p className="text-sm font-medium text-slate-900">{payment.memberName ? `${payment.memberName} (ID ${payment.memberId})` : `Member ID ${payment.memberId}`}</p>
                        <p className="mt-1 text-sm text-slate-600">{payment.account ?? "Account"} • Rs. {payment.paymentAmount} • {new Date(payment.paymentDate).toLocaleString()}</p>
                      </div>
                      <div className="text-right">
                        <p className={`text-sm font-semibold ${payment.status === "failed" ? "text-red-600" : "text-emerald-600"}`}>{payment.status ? payment.status.toUpperCase() : "OK"}</p>
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-6 text-center">
                    <p className="text-sm text-slate-600">No recent payments available.</p>
                  </div>
                )}
              </div>
            </div>

            {/* Recent Login & Logout */}
            <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg">
              <div className="flex items-center gap-3">
                <div className="rounded-xl bg-gradient-to-br from-indigo-600 to-blue-800 p-3 text-white shadow-md">
                  <LogIn size={20} />
                </div>
                <div>
                  <p className="text-sm uppercase tracking-[0.24em] text-slate-500">Recent Login & Logout</p>
                  <p className="mt-1 text-sm text-slate-600">System authentication events</p>
                </div>
              </div>

              <div className="mt-6 space-y-3">
                {((data?.recentLoginLogout && data.recentLoginLogout.length) || (data?.recentActivity && data.recentActivity.length)) ? (
                  (data.recentLoginLogout ?? data.recentActivity).map((ev: any, idx: number) => {
                    const isLogin = (ev.type || ev.action || ev.event || "").toString().toLowerCase().includes("login");
                    const label = isLogin ? "LOGIN" : "LOGOUT";
                    return (
                      <div key={ev.id ?? idx} className="flex items-center justify-between rounded-2xl border border-slate-100 bg-slate-50 p-3">
                        <div className="flex items-center gap-3">
                          <div className={`rounded-full p-2 ${isLogin ? "bg-indigo-100 text-indigo-700" : "bg-sky-100 text-sky-700"}`}>
                            {isLogin ? <LogIn size={16} /> : <LogOut size={16} />}
                          </div>
                          <div>
                            <p className="text-sm font-medium text-slate-900">{ev.userName ?? ev.memberName ?? `User ${ev.userId ?? ev.memberId ?? ""}`}</p>
                            <p className="mt-1 text-sm text-slate-600">{new Date(ev.timestamp ?? ev.time ?? ev.date ?? ev.createdAt ?? Date.now()).toLocaleString()}</p>
                          </div>
                        </div>
                        <div className={`text-sm font-semibold ${isLogin ? "text-indigo-600" : "text-sky-600"}`}>{label}</div>
                      </div>
                    );
                  })
                ) : (
                  <div className="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-6 text-center">
                    <p className="text-sm text-slate-600">No login or logout events found.</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
        {error && <div className="rounded-3xl border border-red-200 bg-red-50 p-6 text-sm text-red-700">{error}</div>}
      </div>
    </main>
  );
}


