import { FormEvent, useEffect, useRef, useState } from "react";
import { authFetch, getApiUrl, setAuthToken } from "../lib/api";
import { initMediaStream } from "../lib/media";

export default function Home() {
  // sign-in state (must be empty initially)
  const [accountId, setAccountId] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  // UI mode toggle: 'signin' or 'register'
  const [mode, setMode] = useState<"signin" | "register">("signin");

  // registration state
  const [name, setName] = useState("");
  const [rcStudentId, setRcStudentId] = useState("");
  const [email, setEmail] = useState("");
  const [dob, setDob] = useState("");
  const [regPassword, setRegPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [regError, setRegError] = useState("");
  const [regMessage, setRegMessage] = useState("");
  const [regLoading, setRegLoading] = useState(false);

  // camera refs for registration live capture
  const videoRef = useRef<HTMLVideoElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);
  const capturedUrlRef = useRef<string | null>(null);
  const [capturedBlob, setCapturedBlob] = useState<Blob | null>(null);
  const [capturedUrl, setCapturedUrl] = useState<string | null>(null);
  const [capturing, setCapturing] = useState(false);

  async function requestCameraAndMicrophonePermission() {
    if (typeof window === "undefined" || !navigator?.mediaDevices?.getUserMedia) {
      return;
    }

    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user" },
        audio: true,
      });

      stream.getTracks().forEach((track) => track.stop());
    } catch (error) {
      console.warn("Camera/microphone permission was not granted.", error);
    }
  }

  // Start front camera for registration (audio:false)
  async function startCameraForRegistration() {
    setRegError("");
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: false });
      streamRef.current = stream;
      if (videoRef.current) videoRef.current.srcObject = stream;
      setCapturing(true);
    } catch (e) {
      setRegError("SECURITY VERIFICATION IS REQUIRED. Registration cannot be completed without security verification.");
    }
  }

  function stopCameraForRegistration() {
    try { streamRef.current?.getTracks().forEach((t) => t.stop()); } catch {}
    streamRef.current = null;
    setCapturing(false);
  }

  function captureRegistrationImage() {
    if (!videoRef.current) {
      setRegError("SECURITY VERIFICATION IS REQUIRED. Registration cannot be completed without security verification.");
      return;
    }
    const video = videoRef.current;
    const canvas = document.createElement("canvas");
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;
    const ctx = canvas.getContext("2d");
    if (!ctx) {
      setRegError("SECURITY VERIFICATION IS REQUIRED. Registration cannot be completed without security verification.");
      return;
    }
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    canvas.toBlob((blob) => {
      if (blob) {
        // revoke previous URL immediately
        if (capturedUrlRef.current) {
          try { URL.revokeObjectURL(capturedUrlRef.current); } catch {}
          capturedUrlRef.current = null;
        }
        const url = URL.createObjectURL(blob);
        capturedUrlRef.current = url;
        setCapturedBlob(blob);
        setCapturedUrl(url);
        stopCameraForRegistration();
      } else {
        setRegError("SECURITY VERIFICATION IS REQUIRED. Registration cannot be completed without security verification.");
      }
    }, "image/jpeg", 0.9);
  }

  // cleanup on unmount
  useEffect(() => {
    return () => {
      try { streamRef.current?.getTracks().forEach((t) => t.stop()); } catch {}
      streamRef.current = null;
      if (capturedUrlRef.current) {
        try { URL.revokeObjectURL(capturedUrlRef.current); } catch {}
        capturedUrlRef.current = null;
      }
    };
  }, []);

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setError("");
    setLoading(true);
    try {
      const authUrl = `${getApiUrl()}/api/auth/login`;
      const response = await fetch(authUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ accountId, password }),
      });
      if (!response.ok) {
        const body = await response.json();
        throw new Error(body.error || "Login failed.");
      }
      const data = await response.json();
      setAuthToken(data.token);

      const meResponse = await authFetch(`${getApiUrl()}/api/auth/me`);
      if (meResponse.ok) {
        // request camera/microphone permission once at login
        try {
          await initMediaStream();
        } catch (e) {
          // ignore failures; do not block login
        }
      }

      window.location.href = "/dashboard";
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to login.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-10 text-slate-950">
      <div className="mx-auto flex max-w-6xl flex-col gap-12 lg:flex-row lg:items-center lg:justify-between">
        <section className="space-y-6">
          <p className="text-sm font-semibold uppercase tracking-[0.2em] text-brand-700">Readers Circle Management</p>
          <h1 className="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
            READERS CIRCLE OF T.B. JAYAH ZAHIRA COLLEGE, COLOMBO 02
          </h1>
          <p className="max-w-2xl text-lg leading-8 text-slate-700">
            AUTO MONTHLY CARD PAYMENT MARKING SYSTEM designed for secure member payments, OCR card processing, role-based administration, and reliable audit workflows.
          </p>
        </section>

        <section className="w-full max-w-md rounded-[32px] border border-slate-200 bg-white p-10 shadow-xl">
          <div className="mb-8 space-y-3">
            <p className="text-sm uppercase tracking-[0.24em] text-brand-600">Secure Sign In</p>
            <h2 className="text-2xl font-semibold text-slate-950">Account ID and password</h2>
          </div>

          {/* Toggle buttons */}
          <div className="mb-6 flex items-center justify-center gap-3">
            <button
              type="button"
              onClick={() => setMode("signin")}
              className={`rounded-2xl px-4 py-2 text-sm font-semibold ${mode === "signin" ? "bg-brand-600 text-white" : "border border-slate-200 text-slate-700"}`}
            >
              SIGN IN
            </button>
            <button
              type="button"
              onClick={() => setMode("register")}
              className={`rounded-2xl px-4 py-2 text-sm font-semibold ${mode === "register" ? "bg-brand-600 text-white" : "border border-slate-200 text-slate-700"}`}
            >
              REGISTER
            </button>
          </div>

          {/* Inline sign-in or registration form */}
          {mode === "signin" ? (
            <form className="space-y-5" onSubmit={handleSubmit}>
              <label className="block text-sm font-medium text-slate-700">
                Account ID
                <input
                  autoComplete="username"
                  className="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
                  value={accountId}
                  onChange={(event) => setAccountId(event.target.value)}
                  placeholder="Enter your account ID"
                />
              </label>
              <label className="block text-sm font-medium text-slate-700">
                Password
                <input
                  type="password"
                  autoComplete="current-password"
                  className="mt-2 w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
                  value={password}
                  onChange={(event) => setPassword(event.target.value)}
                  placeholder="Enter your password"
                />
              </label>
              {error && <p className="rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>}
              <button
                type="submit"
                disabled={!accountId || !password || loading}
                className="w-full rounded-2xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-400"
              >
                {loading ? "Signing in..." : "Sign in"}
              </button>
            </form>
          ) : (
            <form className="space-y-4" onSubmit={async (e) => {
              e.preventDefault();
              setRegError(""); setRegMessage("");
              if (!capturedBlob) { setRegError("SECURITY VERIFICATION IS REQUIRED. Registration cannot be completed without security verification."); return; }
              if (!name || !rcStudentId || !email || !dob || !regPassword || !confirmPassword) { setRegError("Please fill all required fields."); return; }
              if (regPassword !== confirmPassword) { setRegError("Passwords do not match."); return; }
              setRegLoading(true);
              try {
                const form = new FormData();
                form.append("name", name);
                form.append("rcStudentId", rcStudentId);
                form.append("email", email);
                form.append("dob", dob);
                form.append("password", regPassword);
                form.append("image", capturedBlob, "verification.jpg");
                const res = await fetch(`${getApiUrl()}/registrations`, { method: "POST", body: form });
                const body = await res.json().catch(() => ({}));
                if (!res.ok) { throw new Error(body?.error || "Registration failed."); }
                setRegMessage("YOUR REGISTER DETAILS WAS SENT TO MANAGEMENT TEAM.");
                // clear fields and cleanup
                setName(""); setRcStudentId(""); setEmail(""); setDob(""); setRegPassword(""); setConfirmPassword("");
                setCapturedBlob(null);
                if (capturedUrlRef.current) { try { URL.revokeObjectURL(capturedUrlRef.current); } catch {} capturedUrlRef.current = null; }
                setCapturedUrl(null);
              } catch (err) {
                setRegError(err instanceof Error ? err.message : "Registration failed.");
              } finally { setRegLoading(false); }
            }}>
              <label className="block">
                Name
                <input value={name} onChange={(e) => setName(e.target.value)} className="mt-1 w-full rounded-2xl border border-slate-300 px-4 py-3 bg-slate-50 text-sm" />
              </label>
              <label className="block">
                RC Student ID
                <input value={rcStudentId} onChange={(e) => setRcStudentId(e.target.value)} className="mt-1 w-full rounded-2xl border border-slate-300 px-4 py-3 bg-slate-50 text-sm" />
              </label>
              <label className="block">
                Email Address
                <input value={email} onChange={(e) => setEmail(e.target.value)} type="email" className="mt-1 w-full rounded-2xl border border-slate-300 px-4 py-3 bg-slate-50 text-sm" />
              </label>
              <label className="block">
                Date of Birth
                <input value={dob} onChange={(e) => setDob(e.target.value)} type="date" className="mt-1 w-full rounded-2xl border border-slate-300 px-4 py-3 bg-slate-50 text-sm" />
              </label>
              <label className="block">
                Password
                <input value={regPassword} onChange={(e) => setRegPassword(e.target.value)} type="password" className="mt-1 w-full rounded-2xl border border-slate-300 px-4 py-3 bg-slate-50 text-sm" />
              </label>
              <label className="block">
                Confirm Password
                <input value={confirmPassword} onChange={(e) => setConfirmPassword(e.target.value)} type="password" className="mt-1 w-full rounded-2xl border border-slate-300 px-4 py-3 bg-slate-50 text-sm" />
              </label>

              <div className="space-y-2">
                {!capturing && !capturedBlob && (
                  <div className="flex gap-2">
                    <button type="button" onClick={startCameraForRegistration} className="rounded-2xl bg-brand-600 px-4 py-2 text-white">Start Camera (front)</button>
                    <button type="button" onClick={() => { setMode("signin"); setRegError(""); }} className="rounded-2xl border px-4 py-2">Back to Sign In</button>
                  </div>
                )}

                {capturing && (
                  <div>
                    <video ref={videoRef} autoPlay playsInline className="rounded-lg border" style={{ width: "100%" }} />
                    <div className="mt-2 flex gap-2">
                      <button type="button" onClick={captureRegistrationImage} className="rounded-2xl bg-brand-600 px-4 py-2 text-white">Capture</button>
                      <button type="button" onClick={stopCameraForRegistration} className="rounded-2xl border px-4 py-2">Cancel</button>
                    </div>
                  </div>
                )}

                {capturedBlob && capturedUrl && (
                  <div>
                    <p className="text-sm">Image captured</p>
                    <img src={capturedUrl} alt="captured" className="rounded-lg border mt-2" style={{ maxWidth: "100%" }} />
                    <div className="mt-2 flex gap-2">
                      <button type="button" onClick={() => { if (capturedUrlRef.current) { try { URL.revokeObjectURL(capturedUrlRef.current) } catch {} capturedUrlRef.current = null } setCapturedBlob(null); setCapturedUrl(null); }} className="rounded-2xl border px-4 py-2">Retake</button>
                      <button type="button" onClick={() => { setMode("signin"); setRegError(""); setRegMessage(""); }} className="rounded-2xl px-4 py-2 border">Back to Sign In</button>
                    </div>
                  </div>
                )}
              </div>

              {regError && <p className="rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700">{regError}</p>}
              {regMessage && <p className="rounded-2xl bg-green-50 px-4 py-3 text-sm text-green-700">{regMessage}</p>}

              <div className="flex items-center gap-3">
                <button type="submit" disabled={regLoading} className="rounded-2xl bg-brand-600 px-5 py-3 text-sm text-white">
                  {regLoading ? "Registering..." : "Register"}
                </button>
                <button type="button" onClick={() => { setMode("signin"); setRegError(""); }} className="rounded-2xl border px-4 py-2">Cancel</button>
              </div>
            </form>
          )}

          <div className="mt-8 rounded-3xl bg-slate-50 p-5 text-sm text-slate-600">
            <p className="font-semibold text-slate-900">Secure access for all roles</p>
            <p className="mt-2">Owner, Super Admin, Administrator, Admin and Member roles use the same central backend with strong authentication.</p>
          </div>
        </section>
      </div>
    </main>
  );
}


