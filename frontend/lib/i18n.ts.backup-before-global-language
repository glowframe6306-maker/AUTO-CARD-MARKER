export function getStoredLanguage(): AppLanguage { 
  if (typeof window === "undefined") return "English"; 
 
  const value = localStorage.getItem("app-language"); 
 
  if ( 
    value === "English" || 
    value === "Sinhala" || 
    value === "Tamil" 
  ) { 
    return value; 
  } 
 
  return "English"; 
} 
 
export function translateText( 
  text: string, 
  language: AppLanguage 
): string { 
  const clean = text.trim(); 
 
  if (!clean) return text; 
 
  const item = translations[clean]; 
 
  if (!item) return text; 
 
  const translated = item[language]; 
 
  if (!translated) return text; 
 
  return text.replace(clean, translated); 
} 
 
function shouldSkipElement(element: Element): boolean { 
  const tag = element.tagName.toLowerCase(); 
 
  return [ 
    "script", 
    "style", 
    "noscript", 
    "textarea", 
    "input", 
    "select", 
    "option", 
  ].includes(tag); 
} 
 
function translateDocument(language: AppLanguage) { 
  if (typeof document === "undefined") return; 
 
  const walker = document.createTreeWalker( 
    document.body, 
    NodeFilter.SHOW_TEXT 
  ); 
 
  const nodes: Text[] = []; 
 
  let current: Node | null; 
 
  while ((current = walker.nextNode())) { 
    const parent = current.parentElement; 
 
    if (!parent) continue; 
 
    if (shouldSkipElement(parent)) continue; 
 
    nodes.push(current as Text); 
  } 
 
  nodes.forEach((node) => { 
    const original = node.textContent || ""; 
 
    const translated = translateText(original, language); 
 
    if (translated !== original) { 
      node.textContent = translated; 
    } 
  }); 
} 
 
let observer: MutationObserver | null = null; 
 
export function applyGlobalLanguage(language: AppLanguage) { 
  if (typeof window === "undefined") return; 
 
  localStorage.setItem("app-language", language); 
 
  document.documentElement.lang = 
    language === "Sinhala" 
      ? "si" 
      : language === "Tamil" 
      ? "ta" 
      : "en"; 
 
  translateDocument(language); 
 
  if (observer) { 
    observer.disconnect(); 
  } 
 
  observer = new MutationObserver(() => { 
    translateDocument(language); 
  }); 
 
  observer.observe(document.body, { 
    childList: true, 
    subtree: true, 
  }); 
 
  window.dispatchEvent( 
    new CustomEvent("language-updated", { 
      detail: { language }, 
    }) 
  ); 
} 
 
export function applyGlobalAppearance( 
  theme: "system" | "light" | "dark" 
) { 
  if (typeof window === "undefined") return; 
 
  localStorage.setItem("app-theme", theme); 
 
  const root = document.documentElement; 
 
  if (theme === "dark") { 
    root.setAttribute("data-theme", "dark"); 
    root.classList.add("dark"); 
    return; 
  } 
 
  if (theme === "light") { 
    root.setAttribute("data-theme", "light"); 
    root.classList.remove("dark"); 
    return; 
  } 
 
  const prefersDark = window.matchMedia( 
    "(prefers-color-scheme: dark)" 
  ).matches; 
 
  root.setAttribute( 
    "data-theme", 
    prefersDark ? "dark" : "light" 
  ); 
 
  root.classList.toggle("dark", prefersDark); 
} 
