/* =========================================================
   FINAL INPUT / FORM VISUAL SYSTEM
   ========================================================= */

input,
textarea,
select {
  background: #ffffff !important;
  color: #111827 !important;
  -webkit-text-fill-color: #111827 !important;
  caret-color: #2563eb !important;

  border: 1px solid #cbd5e1 !important;
  border-radius: 12px;
}

input::placeholder,
textarea::placeholder {
  color: #64748b !important;
  -webkit-text-fill-color: #64748b !important;
  opacity: 1 !important;
}

input:hover,
textarea:hover,
select:hover {
  border-color: #94a3b8 !important;
}

input:focus,
textarea:focus,
select:focus {
  background: #ffffff !important;
  color: #111827 !important;
  -webkit-text-fill-color: #111827 !important;
  caret-color: #2563eb !important;

  outline: none !important;
  border-color: #3b82f6 !important;

  box-shadow:
    0 0 0 3px rgba(59, 130, 246, 0.14),
    0 8px 24px rgba(15, 23, 42, 0.12) !important;
}

input[type="password"],
input[type="text"],
input[type="email"],
input[type="number"],
input[type="search"] {
  background: #ffffff !important;
  color: #111827 !important;
  -webkit-text-fill-color: #111827 !important;
  caret-color: #2563eb !important;
}

select option {
  background: #ffffff !important;
  color: #111827 !important;
}

input[type="file"] {
  background: #ffffff !important;
  color: #111827 !important;
}

label {
  color: #cbd5e1;
  font-weight: 700;
}

/* Dark UI text */
.card,
.member-info-card,
.app-sidebar,
.topbar {
  color: #f8fafc;
}

/* Important member values */
.member-value {
  color: #f8fafc;
}

.member-value.rc {
  color: #67e8f9;
}

.member-value.name {
  color: #f8fafc;
}

.member-value.account {
  color: #bfdbfe;
}

