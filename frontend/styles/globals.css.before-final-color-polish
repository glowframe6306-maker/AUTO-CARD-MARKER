@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  /* Premium dark navy theme colors */
  --bg-deep: #030610; /* page base */
  --bg-layer-1: rgba(6, 10, 20, 0.6);
  --navy-900: #020617;
  --navy-800: #071031;
  --charcoal: #0b1320;
  --electric-blue: #40c4ff;
  --cyan: #67e8f9;
  --muted-200: #94a3b8;
  --muted-400: #64748b;
  --card-bg: rgba(255,255,255,0.02);
  --card-border: rgba(255,255,255,0.04);
  --glass: rgba(255,255,255,0.03);
  --success: #4ade80;
  color-scheme: dark;
  font-family: Inter, system-ui, sans-serif;
  background-color: var(--bg-deep);
  color: #e6eef8;
}

html, body {
  margin: 0;
  padding: 0;
  min-height: 100%;
  background-color: var(--bg-deep);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

* {
  box-sizing: border-box;
}

button, input, select, textarea {
  font: inherit;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px;
}

.header {
  margin-bottom: 24px;
}

.card {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border: 1px solid var(--card-border);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(2,6,23,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
  backdrop-filter: blur(6px);
  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(2,6,23,0.75);
}

.section {
  margin-bottom: 24px;
}

.section h2 {
  margin: 0 0 12px;
  font-size: 1.05rem;
}

.field-group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 760px) {
  .field-group {
    grid-template-columns: 1fr;
  }
}

.input-file {
  width: 100%;
  padding: 16px;
  border: 1px dashed rgba(255,255,255,0.04);
  background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.0));
  color: var(--muted-200);
  border-radius: 14px;
  text-align: center;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
}

.input-file:hover { transform: translateY(-2px); border-color: rgba(64,196,255,0.14); }

.input-file input {
  display: none;
}

.button {
  border: none;
  border-radius: 12px;
  padding: 14px 22px;
  background: linear-gradient(90deg, #0ea5e9, #2563eb);
  color: white;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(6, 24, 70, 0.6);
  transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.12s ease;
}

.button.secondary {
  background: linear-gradient(90deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
  color: var(--muted-200);
  border: 1px solid rgba(255,255,255,0.03);
}

.button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  filter: grayscale(0.2) opacity(0.8);
}

.button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(6,24,70,0.7);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.02);
  color: var(--cyan);
  font-size: 0.9rem;
  border: 1px solid rgba(255,255,255,0.03);
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead th {
  text-align: left;
  font-size: 0.95rem;
  color: var(--muted-200);
  border-bottom: 1px solid rgba(255,255,255,0.04);
  padding: 12px 10px;
  background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));
}

tbody tr:hover {
  background: rgba(255,255,255,0.02);
}

tbody td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(255,255,255,0.02);
  font-size: 0.95rem;
  color: #dbeafe;
}

.status-chip {
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.85rem;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.03);
  color: var(--muted-200);
}

.status-Processing { background: rgba(99,102,241,0.08); color: #6366f1; border-color: rgba(99,102,241,0.12); }
.status-Marked { background: rgba(16,185,129,0.06); color: #10b981; border-color: rgba(16,185,129,0.08); }
.status-Already\ Marked { background: rgba(250,204,21,0.06); color: #f59e0b; border-color: rgba(250,204,21,0.08); }
.status-Needs\ Review { background: rgba(239,68,68,0.06); color: #ef4444; border-color: rgba(239,68,68,0.08); }
.status-Failed { background: rgba(244,63,94,0.06); color: #ef4444; border-color: rgba(244,63,94,0.08); }

.notification {
  margin-top: 12px;
  padding: 14px 18px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid #d1d5db;
}

.review-card {
  display: grid;
  gap: 16px;
  margin-top: 12px;
}

review-card pre {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  color: #e6eef8;
  padding: 14px;
  border-radius: 12px;
  overflow: auto;
  border: 1px solid rgba(255,255,255,0.03);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.card-chip {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.02);
  color: #cfe9ff;
  cursor: pointer;
  border: 1px solid rgba(255,255,255,0.02);
}

.card-chip.selected {
  background: linear-gradient(90deg, rgba(37,99,235,0.16), rgba(6,182,212,0.12));
  color: white;
  box-shadow: 0 6px 16px rgba(6,24,70,0.6);
}

