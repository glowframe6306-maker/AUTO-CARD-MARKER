@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: light;
  font-family: Inter, system-ui, sans-serif;
  background-color: #f8fafc;
  color: #0f172a;
}

html, body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

* {
  box-sizing: border-box;
}

button, input, select, textarea {
  font: inherit;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px;
}

.header {
  margin-bottom: 24px;
}

.card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.section {
  margin-bottom: 24px;
}

.section h2 {
  margin: 0 0 12px;
  font-size: 1.05rem;
}

.field-group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 760px) {
  .field-group {
    grid-template-columns: 1fr;
  }
}

.input-file {
  width: 100%;
  padding: 16px;
  border: 2px dashed #d1d5db;
  background: #f9fafb;
  border-radius: 14px;
  text-align: center;
  cursor: pointer;
}

.input-file input {
  display: none;
}

.button {
  border: none;
  border-radius: 12px;
  padding: 14px 22px;
  background: #2563eb;
  color: white;
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease;
}

.button.secondary {
  background: #6b7280;
}

.button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 0.9rem;
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead th {
  text-align: left;
  font-size: 0.95rem;
  color: #374151;
  border-bottom: 1px solid #e5e7eb;
  padding: 12px 10px;
}

tbody tr:hover {
  background: #f9fafb;
}

tbody td {
  padding: 12px 10px;
  border-bottom: 1px solid #f3f4f6;
  font-size: 0.95rem;
}

.status-chip {
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.85rem;
}

.status-Processing { background: #eef2ff; color: #4338ca; }
.status-Marked { background: #dcfce7; color: #166534; }
.status-Already\ Marked { background: #fef9c3; color: #92400e; }
.status-Needs\ Review { background: #fde2e8; color: #991b1b; }
.status-Failed { background: #fee2e2; color: #991b1b; }

.notification {
  margin-top: 12px;
  padding: 14px 18px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid #d1d5db;
}

.review-card {
  display: grid;
  gap: 16px;
  margin-top: 12px;
}

.review-card pre {
  background: #111827;
  color: #f8fafc;
  padding: 14px;
  border-radius: 12px;
  overflow: auto;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.card-chip {
  padding: 8px 12px;
  border-radius: 999px;
  background: #e5e7eb;
  color: #111827;
  cursor: pointer;
}

.card-chip.selected {
  background: #2563eb;
  color: white;
}

/* =========================================================
   PREMIUM APPLICATION SHELL
   ========================================================= */

.app-layout {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at 20% 0%, rgba(59, 130, 246, 0.08), transparent 28%),
    radial-gradient(circle at 90% 80%, rgba(14, 165, 233, 0.06), transparent 30%),
    #050816;
}

.app-sidebar {
  width: 280px;
  flex: 0 0 280px;
  height: 100vh;
  position: sticky;
  top: 0;
  z-index: 50;
  color: #e2e8f0;
  background:
    linear-gradient(180deg, rgba(10, 18, 35, 0.98), rgba(3, 8, 20, 0.99));
  border-right: 1px solid rgba(148, 163, 184, 0.12);
  box-shadow: 18px 0 55px rgba(0, 0, 0, 0.22);
}

.sidebar-inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 22px 15px 15px;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 7px 9px 23px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
}

.sidebar-brand-logo {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: #fff;
  background: linear-gradient(135deg, #2563eb, #06b6d4);
  box-shadow:
    0 10px 30px rgba(37, 99, 235, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.sidebar-brand-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sidebar-brand-text strong {
  color: #f8fafc;
  font-size: 0.93rem;
  letter-spacing: 0.09em;
}

.sidebar-brand-text span {
  margin-top: 3px;
  color: #64748b;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.sidebar-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 22px 0 10px;
}

.sidebar-section-title {
  padding: 0 11px 9px;
  color: #64748b;
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.administration-title {
  margin-top: 24px;
}

.sidebar-nav {
  display: grid;
  gap: 5px;
}

.sidebar-link {
  position: relative;
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 45px;
  padding: 0 11px;
  border: 1px solid transparent;
  border-radius: 13px;
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.86rem;
  font-weight: 600;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.sidebar-link:hover {
  color: #f8fafc;
  background: rgba(59, 130, 246, 0.09);
  border-color: rgba(96, 165, 250, 0.1);
  transform: translateX(2px);
}

.sidebar-link.active {
  color: #ffffff;
  background:
    linear-gradient(
      135deg,
      rgba(37, 99, 235, 0.28),
      rgba(14, 165, 233, 0.12)
    );
  border-color: rgba(96, 165, 250, 0.2);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.05),
    0 8px 25px rgba(37, 99, 235, 0.08);
}

.sidebar-link.active::before {
  content: "";
  position: absolute;
  left: -1px;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 0 4px 4px 0;
  background: linear-gradient(#60a5fa, #22d3ee);
  box-shadow: 0 0 14px rgba(34, 211, 238, 0.65);
}

.sidebar-icon {
  width: 24px;
  display: grid;
  place-items: center;
  color: #64748b;
}

.sidebar-link.active .sidebar-icon {
  color: #67e8f9;
}

.sidebar-label {
  flex: 1;
}

.sidebar-active-arrow {
  color: #67e8f9;
}

.sidebar-footer {
  padding-top: 13px;
  border-top: 1px solid rgba(148, 163, 184, 0.1);
}

.security-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  margin-bottom: 9px;
  border: 1px solid rgba(34, 197, 94, 0.13);
  border-radius: 15px;
  background: rgba(34, 197, 94, 0.055);
}

.security-card-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: #86efac;
  background: rgba(34, 197, 94, 0.1);
}

.security-card-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.security-card-content strong {
  color: #d1fae5;
  font-size: 0.75rem;
}

.security-card-content span {
  color: #64748b;
  font-size: 0.65rem;
}

.security-status-dot {
  width: 7px;
  height: 7px;
  margin-left: auto;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 12px rgba(74, 222, 128, 0.8);
}

.logout-button {
  width: 100%;
  min-height: 43px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid rgba(148, 163, 184, 0.1);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.72);
  color: #94a3b8;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.logout-button:hover {
  color: #fca5a5;
  border-color: rgba(248, 113, 113, 0.2);
  background: rgba(127, 29, 29, 0.12);
}

.app-main {
  min-width: 0;
  flex: 1;
}

.topbar {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
  background: rgba(5, 8, 22, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.topbar-left,
.topbar-right {
  display: flex;
  align-items: center;
}

.topbar-left {
  gap: 14px;
}

.topbar-right {
  gap: 15px;
}

.topbar-heading {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.topbar-label {
  color: #64748b;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.topbar-heading strong {
  color: #e2e8f0;
  font-size: 0.88rem;
}

.icon-button,
.mobile-menu,
.mobile-close {
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(15, 23, 42, 0.75);
  color: #94a3b8;
  cursor: pointer;
}

.icon-button {
  position: relative;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
}

.icon-button:hover {
  color: #fff;
  border-color: rgba(96, 165, 250, 0.25);
  background: rgba(37, 99, 235, 0.1);
}

.notification-dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22d3ee;
  box-shadow: 0 0 9px rgba(34, 211, 238, 0.8);
}

.user-mini {
  display: flex;
  align-items: center;
  gap: 9px;
  padding-left: 12px;
  border-left: 1px solid rgba(148, 163, 184, 0.1);
}

.user-avatar {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #bfdbfe;
  background: linear-gradient(
    135deg,
    rgba(37, 99, 235, 0.3),
    rgba(6, 182, 212, 0.14)
  );
}

.user-mini-text {
  display: flex;
  flex-direction: column;
}

.user-mini-text strong {
  color: #e2e8f0;
  font-size: 0.76rem;
}

.user-mini-text span {
  color: #64748b;
  font-size: 0.65rem;
}

.page-content {
  min-height: calc(100vh - 76px);
}

.mobile-menu {
  display: none;
  width: 40px;
  height: 40px;
  border-radius: 11px;
}

.mobile-sidebar {
  display: none;
}

.mobile-overlay {
  display: none;
}

@media (max-width: 900px) {
  .desktop-sidebar {
    display: none;
  }

  .mobile-menu {
    display: grid;
    place-items: center;
  }

  .mobile-sidebar {
    display: block;
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: min(300px, 88vw);
    transform: translateX(-105%);
    transition: transform 0.28s ease;
    z-index: 100;
  }

  .mobile-sidebar.open {
    transform: translateX(0);
  }

  .mobile-overlay {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(4px);
  }

  .mobile-close {
    position: absolute;
    top: 17px;
    right: 14px;
    z-index: 110;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
  }

  .topbar {
    padding: 0 16px;
  }

  .user-mini-text {
    display: none;
  }
}

@media (max-width: 560px) {
  .topbar-heading strong {
    font-size: 0.76rem;
  }

  .topbar-right {
    gap: 7px;
  }

  .user-mini {
    padding-left: 7px;
  }
}
