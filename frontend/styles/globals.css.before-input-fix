@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  /* Premium dark navy theme colors */
  --bg-deep: #030610; /* page base */
  --bg-layer-1: rgba(6, 10, 20, 0.6);
  --navy-900: #020617;
  --navy-800: #071031;
  --charcoal: #0b1320;
  --electric-blue: #40c4ff;
  --cyan: #67e8f9;
  --muted-200: #94a3b8;
  --muted-400: #64748b;
  --card-bg: rgba(255,255,255,0.02);
  --card-border: rgba(255,255,255,0.04);
  --glass: rgba(255,255,255,0.03);
  --success: #4ade80;
  color-scheme: dark;
  font-family: Inter, system-ui, sans-serif;
  background-color: var(--bg-deep);
  color: #e6eef8;
}

html, body {
  margin: 0;
  padding: 0;
  min-height: 100%;
  background-color: var(--bg-deep);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

* {
  box-sizing: border-box;
}

button, input, select, textarea {
  font: inherit;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px;
}

.header {
  margin-bottom: 24px;
}

.card {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border: 1px solid var(--card-border);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(2,6,23,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
  backdrop-filter: blur(6px);
  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(2,6,23,0.75);
}

.section {
  margin-bottom: 24px;
}

.section h2 {
  margin: 0 0 12px;
  font-size: 1.05rem;
}

.field-group {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 760px) {
  .field-group {
    grid-template-columns: 1fr;
  }
}

.input-file {
  width: 100%;
  padding: 16px;
  border: 1px dashed rgba(255,255,255,0.04);
  background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.0));
  color: var(--muted-200);
  border-radius: 14px;
  text-align: center;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
}

.input-file:hover { transform: translateY(-2px); border-color: rgba(64,196,255,0.14); }

.input-file input {
  display: none;
}

.button {
  border: none;
  border-radius: 12px;
  padding: 14px 22px;
  background: linear-gradient(90deg, #0ea5e9, #2563eb);
  color: white;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(6, 24, 70, 0.6);
  transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.12s ease;
}

.button.secondary {
  background: linear-gradient(90deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
  color: var(--muted-200);
  border: 1px solid rgba(255,255,255,0.03);
}

.button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  filter: grayscale(0.2) opacity(0.8);
}

.button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(6,24,70,0.7);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.02);
  color: var(--cyan);
  font-size: 0.9rem;
  border: 1px solid rgba(255,255,255,0.03);
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead th {
  text-align: left;
  font-size: 0.95rem;
  color: var(--muted-200);
  border-bottom: 1px solid rgba(255,255,255,0.04);
  padding: 12px 10px;
  background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));
}

tbody tr:hover {
  background: rgba(255,255,255,0.02);
}

tbody td {
  padding: 12px 10px;
  border-bottom: 1px solid rgba(255,255,255,0.02);
  font-size: 0.95rem;
  color: #dbeafe;
}

.status-chip {
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.85rem;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.03);
  color: var(--muted-200);
}

.status-Processing { background: rgba(99,102,241,0.08); color: #6366f1; border-color: rgba(99,102,241,0.12); }
.status-Marked { background: rgba(16,185,129,0.06); color: #10b981; border-color: rgba(16,185,129,0.08); }
.status-Already\ Marked { background: rgba(250,204,21,0.06); color: #f59e0b; border-color: rgba(250,204,21,0.08); }
.status-Needs\ Review { background: rgba(239,68,68,0.06); color: #ef4444; border-color: rgba(239,68,68,0.08); }
.status-Failed { background: rgba(244,63,94,0.06); color: #ef4444; border-color: rgba(244,63,94,0.08); }

.notification {
  margin-top: 12px;
  padding: 14px 18px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid #d1d5db;
}

.review-card {
  display: grid;
  gap: 16px;
  margin-top: 12px;
}

review-card pre {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  color: #e6eef8;
  padding: 14px;
  border-radius: 12px;
  overflow: auto;
  border: 1px solid rgba(255,255,255,0.03);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.card-chip {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255,255,255,0.02);
  color: #cfe9ff;
  cursor: pointer;
  border: 1px solid rgba(255,255,255,0.02);
}

.card-chip.selected {
  background: linear-gradient(90deg, rgba(37,99,235,0.16), rgba(6,182,212,0.12));
  color: white;
  box-shadow: 0 6px 16px rgba(6,24,70,0.6);
}

/* Prominent label/value presentation for member/account fields inside cards */
.card p {
  margin: 0 0 12px;
  color: #dbeafe;
  font-size: 1.03rem;
  line-height: 1.25;
}

.card p strong {
  display: block;
  color: var(--muted-200);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 6px;
}

/* Small header lines (topbar/member header) keep a clear hierarchy */
.topbar .topbar-heading p, .page-content header p, .page-content header .text-sm {
  color: var(--muted-200);
  font-size: 0.82rem;
}

/* Make inline status/value text a little stronger in cards */
.card p span, .card p em {
  color: #e6eef8;
  font-weight: 700;
}

/* Monospace look for account-like inline values when developers used <code> */
.card code, .page-content code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, 'Roboto Mono', 'Courier New', monospace;
  background: rgba(255,255,255,0.02);
  padding: 2px 6px;
  border-radius: 6px;
  border: 1px solid rgba(255,255,255,0.02);
}

/* Member Information premium glass card */
.member-info-card {
  background: linear-gradient(180deg, rgba(6,10,22,0.6), rgba(8,15,30,0.5));
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(2,6,23,0.6);
  border: 1px solid rgba(255,255,255,0.04);
  position: relative;
  overflow: hidden;
}

.member-info-card:before {
  content: "";
  position: absolute;
  inset: -1px;
  background: linear-gradient(90deg, rgba(40,94,255,0.08), rgba(6,182,212,0.05));
  pointer-events: none;
  mix-blend-mode: overlay;
}

.member-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  align-items: center;
}

.member-field {
  display: flex;
  flex-direction: column;
}

.member-label {
  color: var(--muted-200);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 800;
  margin-bottom: 6px;
}

.member-value {
  color: #f8fbff;
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.15;
}

/* RC No prominence */
.member-value.rc {
  color: #7ee7ff;
  font-size: 1.9rem;
  font-weight: 900;
  letter-spacing: -0.01em;
}

.member-value.name {
  font-size: 1.35rem;
  font-weight: 800;
}

.member-value.account {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, 'Roboto Mono', monospace;
}

/* Role badge styling */
.role-badge {
  display: inline-block;
  padding: 6px 10px;
  border-radius: 12px;
  background: linear-gradient(90deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
  border: 1px solid rgba(255,255,255,0.03);
  color: #eaf6ff;
  font-weight: 700;
}

/* Card hover elevation */
.member-info-card:hover {
  transform: translateY(-6px);
  transition: transform 180ms ease, box-shadow 180ms ease;
  box-shadow: 0 18px 40px rgba(2,6,23,0.65);
}

/* Header icon coloring */
.member-info-card .lucide {
  color: #91e5ff;
  opacity: 0.95;
}

.status-badge {
  display: inline-block;
  padding: 6px 10px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.82rem;
  color: #061226;
}

.status-active { background: linear-gradient(90deg,#22c55e,#86efac); }
.status-inactive { background: linear-gradient(90deg,#fb7185,#fca5a5); color: #2b0218; }
.status-pending { background: linear-gradient(90deg,#f59e0b,#fcd34d); }

@media (max-width: 768px) {
  .member-info-grid { grid-template-columns: 1fr; }
  .member-info-card { padding: 16px; }
  .member-value.rc { font-size: 1.28rem; }
}

/* =========================================================
   PREMIUM APPLICATION SHELL
   ========================================================= */

.app-layout {
  min-height: 100vh;
  display: flex;
  background:
    radial-gradient(1200px 600px at 10% 5%, rgba(64,196,255,0.02), transparent 12%),
    radial-gradient(800px 400px at 95% 85%, rgba(102,126,234,0.02), transparent 14%),
    linear-gradient(180deg, var(--bg-deep), rgba(3,8,20,0.9));
}

.app-sidebar {
  width: 280px;
  flex: 0 0 280px;
  height: 100vh;
  position: sticky;
  top: 0;
  z-index: 50;
  color: #e2e8f0;
  background: linear-gradient(180deg, rgba(6,10,20,0.96), rgba(3,8,20,0.94));
  border-right: 1px solid rgba(255,255,255,0.03);
  box-shadow: 24px 0 60px rgba(2,6,23,0.6);
  backdrop-filter: blur(6px);
}

.sidebar-inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 22px 15px 15px;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 7px 9px 23px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
}

.sidebar-brand-logo {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: #fff;
  background: linear-gradient(135deg, rgba(37,99,235,0.2), rgba(6,182,212,0.12));
  box-shadow: 0 8px 22px rgba(6,24,70,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
}

.sidebar-brand-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sidebar-brand-text strong {
  color: #f8fafc;
  font-size: 0.93rem;
  letter-spacing: 0.09em;
}

.sidebar-brand-text span {
  margin-top: 3px;
  color: #64748b;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.sidebar-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 22px 0 10px;
}

.sidebar-section-title {
  padding: 0 11px 9px;
  color: #64748b;
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.administration-title {
  margin-top: 24px;
}

.sidebar-nav {
  display: grid;
  gap: 5px;
}

.sidebar-link {
  position: relative;
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 45px;
  padding: 0 11px;
  border: 1px solid transparent;
  border-radius: 13px;
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.86rem;
  font-weight: 600;
  transition:
    color 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.sidebar-link:hover {
  color: #f8fafc;
  background: linear-gradient(90deg, rgba(37,99,235,0.06), rgba(6,182,212,0.03));
  border-color: rgba(96, 165, 250, 0.08);
  transform: translateX(2px);
  box-shadow: 0 6px 18px rgba(6,24,70,0.45);
}

.sidebar-link.active {
  color: #ffffff;
  background: linear-gradient(135deg, rgba(37,99,235,0.22), rgba(6,182,212,0.08));
  border-color: rgba(96, 165, 250, 0.22);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.02), 0 12px 40px rgba(37,99,235,0.12);
}

.sidebar-link.active::before {
  content: "";
  position: absolute;
  left: -1px;
  top: 10px;
  bottom: 10px;
  width: 4px;
  border-radius: 0 6px 6px 0;
  background: linear-gradient(180deg, rgba(96,165,250,0.9), rgba(34,211,238,0.9));
  box-shadow: 0 0 18px rgba(34,211,238,0.45);
}

.sidebar-icon {
  width: 24px;
  display: grid;
  place-items: center;
  color: #64748b;
}

.sidebar-link.active .sidebar-icon {
  color: #67e8f9;
}

.sidebar-label {
  flex: 1;
}

.sidebar-active-arrow {
  color: #67e8f9;
}

.sidebar-footer {
  padding-top: 13px;
  border-top: 1px solid rgba(148, 163, 184, 0.1);
}

.security-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  margin-bottom: 9px;
  border: 1px solid rgba(74,222,128,0.08);
  border-radius: 15px;
  background: linear-gradient(180deg, rgba(74,222,128,0.03), rgba(255,255,255,0.01));
  box-shadow: 0 6px 20px rgba(2,6,23,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
}

.security-card-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: #86efac;
  background: linear-gradient(135deg, rgba(74,222,128,0.12), rgba(16,185,129,0.06));
  box-shadow: 0 6px 18px rgba(74,222,128,0.06);
}

.security-card-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.security-card-content strong {
  color: #d1fae5;
  font-size: 0.75rem;
}

.security-card-content span {
  color: #64748b;
  font-size: 0.65rem;
}

.security-status-dot {
  width: 8px;
  height: 8px;
  margin-left: auto;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 12px rgba(74,222,128,0.85);
}

.logout-button {
  width: 100%;
  min-height: 43px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid rgba(255,255,255,0.03);
  border-radius: 12px;
  background: linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  color: var(--muted-200);
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: 0.18s ease;
  box-shadow: 0 6px 18px rgba(2,6,23,0.6);
}

.logout-button:hover {
  color: #ffd7d7;
  border-color: rgba(248,113,113,0.14);
  background: linear-gradient(90deg, rgba(248,113,113,0.06), rgba(255,255,255,0.01));
}

.app-main {
  min-width: 0;
  flex: 1;
}

.topbar {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  background: linear-gradient(180deg, rgba(2,6,23,0.7), rgba(2,6,23,0.55));
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 6px 20px rgba(2,6,23,0.6), inset 0 -1px 0 rgba(64,196,255,0.02);
}

.topbar-left,
.topbar-right {
  display: flex;
  align-items: center;
}

.topbar-left {
  gap: 14px;
}

.topbar-right {
  gap: 15px;
}

.topbar-heading {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.topbar-label {
  color: #64748b;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.topbar-heading strong {
  color: #e2e8f0;
  font-size: 0.88rem;
}

.icon-button,
.mobile-menu,
.mobile-close {
  border: 1px solid rgba(255,255,255,0.03);
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  color: var(--muted-200);
  cursor: pointer;
  transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
}

.icon-button {
  position: relative;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
}

.icon-button:hover {
  color: #fff;
  border-color: rgba(64,196,255,0.18);
  background: linear-gradient(90deg, rgba(37,99,235,0.06), rgba(6,182,212,0.03));
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(6,24,70,0.6);
}

.notification-dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 12px rgba(34,211,238,0.7);
}

.user-mini {
  display: flex;
  align-items: center;
  gap: 9px;
  padding-left: 12px;
  border-left: 1px solid rgba(148, 163, 184, 0.1);
}

.user-avatar {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #cfe9ff;
  background: linear-gradient(135deg, rgba(37,99,235,0.26), rgba(6,182,212,0.12));
  box-shadow: 0 6px 18px rgba(6,24,70,0.6);
}

.user-mini-text {
  display: flex;
  flex-direction: column;
}

.user-mini-text strong {
  color: #e2e8f0;
  font-size: 0.76rem;
}

.user-mini-text span {
  color: #64748b;
  font-size: 0.65rem;
}

.page-content {
  min-height: calc(100vh - 76px);
}

.mobile-menu {
  display: none;
  width: 40px;
  height: 40px;
  border-radius: 11px;
}

.mobile-sidebar {
  display: none;
}

.mobile-overlay {
  display: none;
}

@media (max-width: 900px) {
  .desktop-sidebar {
    display: none;
  }

  .mobile-menu {
    display: grid;
    place-items: center;
  }

  .mobile-sidebar {
    display: block;
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: min(300px, 88vw);
    transform: translateX(-105%);
    transition: transform 0.28s ease;
    z-index: 100;
  }

  .mobile-sidebar.open {
    transform: translateX(0);
  }

  .mobile-overlay {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(4px);
  }

  .mobile-close {
    position: absolute;
    top: 17px;
    right: 14px;
    z-index: 110;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
  }

  .topbar {
    padding: 0 16px;
  }

  .user-mini-text {
    display: none;
  }
}

@media (max-width: 560px) {
  .topbar-heading strong {
    font-size: 0.76rem;
  }

  .topbar-right {
    gap: 7px;
  }

  .user-mini {
    padding-left: 7px;
  }
}

/* Scrollbar (desktop) */
::-webkit-scrollbar { height: 12px; width: 10px; }
::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); }
::-webkit-scrollbar-thumb { background: linear-gradient(180deg, rgba(64,196,255,0.12), rgba(37,99,235,0.12)); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, rgba(64,196,255,0.16), rgba(37,99,235,0.16)); }

/* Text selection color */
::selection { background: rgba(64,196,255,0.14); color: #e6f8ff; }

/* Subtle focus outlines for accessibility */
button:focus, .icon-button:focus, input:focus, textarea:focus, select:focus { outline: none; box-shadow: 0 0 0 4px rgba(64,196,255,0.08), 0 6px 18px rgba(2,6,23,0.6); border-color: rgba(64,196,255,0.18); }

/* Inputs styling refinement */
input, select, textarea {
  background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.00));
  border: 1px solid rgba(255,255,255,0.03);
  color: #e6eef8;
  padding: .5rem .75rem;
  border-radius: 10px;
}

input::placeholder, textarea::placeholder { color: rgba(230,238,248,0.45); }

/* subtle transitions */
* { transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease; }
